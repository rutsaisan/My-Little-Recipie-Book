{
  "name": "my-little-recipe-book",
  "private": true,
  "version": "0.1.0",
  "description": "Recetario digital interactivo con estética cozy: un pequeño libro mágico de cocina.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n app,ia -c \"#BB9C86,#976E4F\" \"vite\" \"npm:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "cross-env BASE_PATH=/my-little-recipe-book/ VITE_IMPORT_SERVER=off npm run build",
    "preview:pages": "vite preview --base /my-little-recipe-book/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "dev:app": "vite",
    "server": "node --watch-path=server server/index.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
