# Copia este archivo como `.env.local` para tus valores locales (no se sube a git).
#
# IMPORTANTE: las variables que empiezan por VITE_ acaban dentro del código que
# descarga el navegador. Nunca pongas aquí claves privadas de APIs: esas van
# en las variables del servidor (más abajo, sin el prefijo VITE_).

# Dónde se guardan las recetas.
#   local → IndexedDB de este navegador (fase 1, funciona sin servidor)
#   (en el futuro: api → backend con base de datos y cuentas de usuario)
VITE_DATA_SOURCE=local

# ¿Hay servidor de importación con IA junto a la web? «off» en la versión
# publicada en GitHub Pages (solo archivos): la ventana lo explica.
# VITE_IMPORT_SERVER=off

# ── Importación con IA (fase 4) ────────────────────────────────────────────
# Estas variables las lee SOLO el servidor local (`server/`), nunca el
# navegador: por eso no llevan el prefijo VITE_. Ponlas en un archivo `.env`.

# Proveedor de IA:
#   ollama             → modelos en este ordenador (gratis, sin enviar nada fuera)
#   openai-compatible  → OpenAI, Groq, OpenRouter, LM Studio… (necesita AI_API_KEY)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Modelo que ordena el texto en receta y modelo que mira los fotogramas
# («none» para no mirar imágenes).
AI_TEXT_MODEL=qwen3:8b
AI_VISION_MODEL=gemma3:4b

# Solo para openai-compatible:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=tu-clave-privada

# Transcripción del audio con Whisper (pip install openai-whisper)
WHISPER_MODEL=base
# PYTHON=python
# Descarga de vídeos de enlaces (opcional): https://github.com/yt-dlp/yt-dlp
# YT_DLP=yt-dlp
# IMPORT_SERVER_PORT=8787
